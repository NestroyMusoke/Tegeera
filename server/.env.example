# Preferred for the Nebius x NVIDIA hackathon. Server-side secret: never commit it.
NEBIUS_API_KEY=
# NVIDIA Nemotron 3 Super served by Nebius Token Factory.
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_API_KEY is an optional direct-Catalog fallback, but does not meet the
# hackathon's Nebius service requirement on its own.
# Replace or extend with the exact origin of your public web demo.
ALLOWED_ORIGINS=http://localhost:5173,https://localhost,https://nestroymusoke.github.io
PORT=8080
# Prototype safety limits; each running process keeps its own counters in memory.
MAX_REQUESTS_PER_CLIENT_PER_MINUTE=12
MAX_CONCURRENT_MODEL_REQUESTS=2
MAX_PROVIDER_CALLS_PER_DAY=80
