{
  "name": "tegeera",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "verify:bundle": "node scripts/check-bundle.mjs",
    "test": "vitest run",
    "test:glyph-pack": "node --test scripts/build-glyph-pack.node-spec.mjs",
    "build:emoji-index": "node scripts/build-emoji-index.mjs",
    "test:live:glyph": "node scripts/run-live-glyph-smoke.mjs",
    "glyph-pack": "node scripts/build-glyph-pack.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "preview": "vite preview",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@eslint/js": "^9.34.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@visioncortex/vtracer": "^1.0.0-alpha.4",
    "@vitejs/plugin-react": "^5.0.2",
    "@xmldom/xmldom": "^0.9.12",
    "emojibase-data": "^17.0.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "svgo": "^4.1.0",
    "svgpath": "^2.6.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
